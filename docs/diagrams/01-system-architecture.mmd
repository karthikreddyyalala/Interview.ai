%% Crucible — DEPLOYED architecture (as of 2026-09-04).
%% Solid line  = built & live, always on the request path.
%% Dotted line = planned / not yet built.
%% Dashed subgraph border = built & live in production, but config-gated at
%%   runtime (degrades gracefully to a fallback if the env vars are unset).
flowchart TB
    subgraph Client["Frontend — React + TS + Vite (SPA)"]
        UI[Interview UI / Setup / Results]
        VOICE[Browser voice: Web Speech STT + TTS]
        AVA[Interviewer avatar UI<br/>Tavus live video, else stylized fallback]
    end

    subgraph CDN["AWS edge — HTTPS"]
        CF[CloudFront distribution]
        S3F[S3 — static site bucket]
    end

    subgraph Identity["Amazon Cognito"]
        AUTH[User pool: crucible-users<br/>app client: crucible-web]
    end

    subgraph API["Public API"]
        APIGW[API Gateway — HTTP API]
    end

    subgraph Compute["AWS Lambda — FastAPI via Mangum (python3.12)"]
        ROUTES[REST routes: start / turn / finalize / memory / avatar]
        subgraph Graph["LangGraph — 5-agent pipeline"]
            IN[Intake Agent]
            PL[Planner Agent]
            IV[Interviewer Agent]
            EV[Evaluator Agent]
            MEM[Memory Agent]
        end
    end

    subgraph AI["Reasoning — Amazon Bedrock (us-west-2)"]
        HAIKU[Claude Haiku 4.5 — intake + memory]
        SONNET[Claude Sonnet 4.6 — planner + interviewer + evaluator]
    end

    subgraph Data["Persistence"]
        DDB[(DynamoDB — crucible-memory)]
        LSTORE[Browser localStorage — active session autosave]
    end

    subgraph Guards["Cost + safety"]
        BUDGET[AWS Budget alert — $10/mo]
        CONC[Lambda concurrency cap — account limit 10]
    end

    subgraph AvatarSvc["Tavus avatar service — optional, config-gated"]
        TAVUS[Tavus avatar service]
        DAILY[Daily.co WebRTC]
    end

    %% planned / not yet built
    PROV[Premium voice upgrade: Deepgram · ElevenLabs]

    UI --> CF
    CF --> S3F
    UI -->|sign up / sign in| AUTH
    UI -->|fetch /api<br/>Bearer ID token| APIGW
    APIGW --> ROUTES
    ROUTES -->|verify ID token via JWKS| AUTH
    ROUTES --> IN
    IN --> PL
    PL -. reads .-> MEM
    IV --> EV
    EV --> MEM
    IN --> HAIKU
    MEM --> HAIKU
    PL --> SONNET
    IV --> SONNET
    EV --> SONNET
    MEM --> DDB
    ROUTES --> DDB
    UI --> LSTORE
    ROUTES -->|create / end conversation| TAVUS
    AVA <-->|join room, live video + audio| DAILY
    VOICE -. upgrade .-> PROV

    style AvatarSvc stroke-dasharray: 5 5
