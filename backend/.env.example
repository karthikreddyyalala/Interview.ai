# Bedrock / AWS
INTERVIEWAI_AWS_REGION=us-west-2

# Per-agent models. Model IDs are Bedrock inference-profile IDs — CONFIRM
# exact values in the Bedrock console for your region; these are
# env-overridable defaults. Cheap structured work (intake, memory) runs on
# Haiku; the agents that carry the product (planner, interviewer, evaluator,
# coach) run on Sonnet. Opus is intentionally avoided — ~5x the cost for
# marginal gain here, don't override into it.
INTERVIEWAI_HAIKU_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
INTERVIEWAI_SONNET_MODEL=us.anthropic.claude-sonnet-4-6
INTERVIEWAI_INTAKE_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
INTERVIEWAI_PLANNER_MODEL=us.anthropic.claude-sonnet-4-6
INTERVIEWAI_INTERVIEWER_MODEL=us.anthropic.claude-sonnet-4-6
INTERVIEWAI_EVALUATOR_MODEL=us.anthropic.claude-sonnet-4-6
INTERVIEWAI_MEMORY_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
INTERVIEWAI_COACH_MODEL=us.anthropic.claude-sonnet-4-6

# Set to 1 to run gated real-LLM eval tests
INTERVIEWAI_RUN_LLM_EVALS=0

# Persistence. "memory" keeps everything in-process (tests, local dev with
# no AWS tables). "dynamodb" persists MemoryProfile across sessions/devices.
INTERVIEWAI_PERSISTENCE=memory
INTERVIEWAI_MEMORY_TABLE=crucible-memory

# Comma-separated allowed browser origins for CORS. Localhost for dev; add
# the deployed frontend origin (CloudFront domain) via INTERVIEWAI_CORS_ORIGINS.
INTERVIEWAI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Auth. When auth_required is true, every /api call (except /health) must
# carry a valid Cognito ID token; the candidate id is taken from its `sub`
# claim, not the request. Off by default so tests/local dev stay anonymous.
#
# Deploying: this .env file is NOT read by deploy/deploy-backend.sh (the
# Lambda gets its env from update-function-configuration, which REPLACES the
# whole environment on every deploy). To ship a deployment with auth
# enforced, export CRUCIBLE_COGNITO_USER_POOL_ID and CRUCIBLE_COGNITO_CLIENT_ID
# (and optionally CRUCIBLE_AUTH_REQUIRED / CRUCIBLE_COGNITO_REGION) in the
# deployer's own shell before running deploy/deploy-backend.sh — see that
# script's header. Leaving them unset silently redeploys with auth disabled.
INTERVIEWAI_AUTH_REQUIRED=false
INTERVIEWAI_COGNITO_REGION=us-west-2
INTERVIEWAI_COGNITO_USER_POOL_ID=
INTERVIEWAI_COGNITO_CLIENT_ID=

# Optional Tavus video avatar. Leave the key blank to keep the stylized avatar.
# Set all three (from your Tavus dashboard) to turn on the live video interviewer.
# The key stays server-side; the browser only ever receives the room URL.
INTERVIEWAI_TAVUS_API_KEY=
INTERVIEWAI_TAVUS_REPLICA_ID=
INTERVIEWAI_TAVUS_PERSONA_ID=
INTERVIEWAI_TAVUS_BASE_URL=https://tavusapi.com
